views:
  - type: cards
    name: Visualizaçao padrão
    filters:
      or:
        - file.folder == "01 Pessoal"
        - file.folder == "01 Pessoal/Read"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - author
      - file.embeds
    image: note.coverUrl
    cardSize: 240
    imageAspectRatio: 1.5
  - type: table
    name: Tabela
    order:
      - file.name
    sort:
      - property: img
        direction: DESC
    columnSize:
      file.name: 361
